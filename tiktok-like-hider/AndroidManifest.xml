<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amino.tiktoklikehider"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33"/>

    <application
        android:theme="@android:style/Theme.DeviceDefault.Light"
        android:label="aMiNo TikTok Like Hider"
        android:icon="@drawable/ic_launcher"
        android:hasCode="true">

        <activity android:name="com.amino.tiktoklikehider.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name="com.amino.tiktoklikehider.DiagActivity" android:exported="false"/>

        <provider
            android:name="com.amino.tiktoklikehider.ConfigProvider"
            android:exported="true"
            android:authorities="com.amino.tiktoklikehider.config"/>

        <!-- v1.3: receives persistent diagnostics from the patched TikTok process -->
        <receiver
            android:name="com.amino.tiktoklikehider.DiagReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.amino.tiktoklikehider.ACTION_DIAG"/>
            </intent-filter>
        </receiver>

        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:value="Hide TikTok UI elements (likes, comments, share, ...) - settings UI + persistent diagnostics"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposedscope" android:value="com.zhiliaoapp.musically;com.zhiliaoapp.musically.lite"/>
    </application>
</manifest>
