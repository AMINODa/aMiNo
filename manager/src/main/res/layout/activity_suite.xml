<?xml version="1.0" encoding="utf-8"?>
<!-- aMiNo v2 SUITE — the one screen that installs/opens the bundled suite apps.
     Full aMiNo background identity: #0B0B0E stage, #131318 cards with #2B2B33
     hairlines, red #D32F2F/#E53935 accents, text #F2F2F5 → #6E6E78. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0E">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/suite_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0B0B0E"
        app:title="@string/suite_title"
        app:titleTextColor="#E53935"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:navigationIcon="@drawable/ic_back_24"
        app:navigationIconTint="#E53935" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/suite_shell_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9EA0AA"
                android:textSize="13sp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:id="@+id/suite_card_rinigan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_chat_pill">

                <TextView
                    android:id="@+id/suite_rinigan_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="aMiNo Rinigan"
                    android:textColor="#F2F2F5"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/suite_rinigan_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/suite_rinigan_role"
                    android:textColor="#9EA0AA"
                    android:textSize="13sp"
                    android:paddingTop="2dp" />

                <TextView
                    android:id="@+id/suite_rinigan_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C9C9D2"
                    android:textSize="14sp"
                    android:paddingTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/suite_rinigan_install"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/suite_install"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#D32F2F"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/suite_rinigan_open"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/suite_open"
                        android:textColor="#FF867C"
                        app:strokeColor="#2B2B33" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/suite_card_patcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chat_pill">

                <TextView
                    android:id="@+id/suite_patcher_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="aMiNo Patcher"
                    android:textColor="#F2F2F5"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/suite_patcher_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/suite_patcher_role"
                    android:textColor="#9EA0AA"
                    android:textSize="13sp"
                    android:paddingTop="2dp" />

                <TextView
                    android:id="@+id/suite_patcher_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C9C9D2"
                    android:textSize="14sp"
                    android:paddingTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/suite_patcher_install"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/suite_install"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#D32F2F"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/suite_patcher_open"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/suite_open"
                        android:textColor="#FF867C"
                        app:strokeColor="#2B2B33" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/suite_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/suite_hint"
                android:textColor="#6E6E78"
                android:textSize="12sp"
                android:paddingTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
